{
  "name": "agentpay-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "agents/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "dev:seller": "npm run dev --workspace=@agentpay/seller",
    "dev:gateway": "npm run dev --workspace=@agentpay/gateway",
    "buyer": "npm run buyer --workspace=@agentpay/buyer --",
    "bench": "npm run bench --workspace=@agentpay/buyer --"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
